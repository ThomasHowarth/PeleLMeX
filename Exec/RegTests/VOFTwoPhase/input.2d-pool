# Flat water layer at rest under air in a closed box (density ratio ~830).
# The exact solution is hydrostatic; the velocity measures the force
# imbalance between the cell-centered gravity and the nodal projection.

#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0

peleLM.lo_bc = SlipWallAdiab SlipWallAdiab
peleLM.hi_bc = SlipWallAdiab SlipWallAdiab

#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 64 64
amr.v               = 1
amr.max_level       = 1
amr.ref_ratio       = 2 2
amr.regrid_int      = 4
amr.n_error_buf     = 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 64

#--------------------------- Problem ----------------------------
prob.type  = pool
prob.depth = 0.53

#-------------------------PeleLM CONTROL-------------------------
peleLM.v              = 1
peleLM.incompressible = 1
peleLM.rho            = 1.0
peleLM.mu             = 1.0e-3
peleLM.gravity        = 0.0 -9.81

peleLM.vof.rho_liquid = 1000.0
peleLM.vof.rho_gas    = 1.2
peleLM.vof.mu_liquid  = 1.0e-3
peleLM.vof.mu_gas     = 1.8e-5

amr.cfl       = 0.45
amr.dt_shrink = 1.0
amr.init_dt   = 1.0e-3
amr.max_dt    = 1.0e-3
amr.stop_time = 1.0
amr.max_step  = 100000
amr.plot_per  = 0.25
amr.plot_file = plt_pool_
amr.check_int = -1

nodal_proj.rtol = 1.0e-10
mac_proj.rtol   = 1.0e-10
