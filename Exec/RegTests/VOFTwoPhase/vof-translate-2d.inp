# CI: 1000:1 drop in a uniform flow, 2 levels.  The fixed step gives a
# face Courant number of 0.77 on the fine level; the velocity must stay
# exactly uniform
#----------------------- Geometry ------------------------------
geometry.is_periodic = 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0
peleLM.lo_bc = Interior Interior
peleLM.hi_bc = Interior Interior

#----------------------- AMR -----------------------------------
amr.n_cell          = 32 32
amr.v               = 1
amr.max_level       = 1
amr.ref_ratio       = 2
amr.regrid_int      = 4
amr.n_error_buf     = 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 32

#----------------------- Problem -------------------------------
prob.type     = translate
prob.center   = 0.5 0.5
prob.radius   = 0.2
prob.velocity = 1.0 1.0

#----------------------- PeleLMeX ------------------------------
peleLM.v              = 1
peleLM.incompressible = 1
peleLM.vof.rho_liquid = 1000.0
peleLM.vof.rho_gas    = 1.0
peleLM.vof.mu_liquid  = 1.0e-3
peleLM.vof.mu_gas     = 1.0e-3
peleLM.vof.v          = 1

#----------------------- Time stepping -------------------------
amr.fixed_dt  = 0.012
amr.max_step  = 10
amr.stop_time = 1.0
amr.plot_file = plt
amr.check_int = -1

#----------------------- Temporals (read by Tests/test_vof.py) -
peleLM.do_temporals = 1
peleLM.temporal_int = 1
peleLM.do_extremas  = 1
