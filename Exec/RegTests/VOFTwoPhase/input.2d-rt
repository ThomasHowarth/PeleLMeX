# Rayleigh-Taylor instability (Tryggvason 1988; Guermond & Quartapelle
# 2000): heavy fluid (rho = 3) above light fluid (rho = 1), Atwood 0.5,
# g = 1, d = 1, Re = rho_l d^1.5 g^0.5 / mu = 3000.  Slip side walls,
# no-slip top and bottom.  Times are often quoted as t* = t sqrt(At g/d).

#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 4.0

peleLM.lo_bc = SlipWallAdiab NoSlipWallAdiab
peleLM.hi_bc = SlipWallAdiab NoSlipWallAdiab

#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 32 128
amr.v               = 1
amr.max_level       = 2
amr.ref_ratio       = 2 2 2
amr.regrid_int      = 4
amr.n_error_buf     = 2 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 64

#--------------------------- Problem ----------------------------
prob.type       = rt
prob.depth      = 2.0
prob.amplitude  = 0.1
prob.wavelength = 1.0

#-------------------------PeleLM CONTROL-------------------------
peleLM.v              = 1
peleLM.incompressible = 1
peleLM.vof.rho_liquid = 3.0
peleLM.vof.rho_gas    = 1.0
peleLM.vof.mu_liquid  = 3.3333333333e-4
peleLM.vof.mu_gas     = 3.3333333333e-4
peleLM.gravity        = 0.0 -1.0

peleLM.vof.v          = 1

amr.cfl       = 0.45
amr.dt_shrink = 1.0
amr.init_dt   = 1.0e-3
amr.max_dt    = 1.0e-2
amr.stop_time = 5.0
amr.max_step  = 100000
amr.plot_per  = 0.5
amr.plot_file = plt_rt_
amr.check_int = -1
