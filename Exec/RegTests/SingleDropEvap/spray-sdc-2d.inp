# spray_SDC temporal convergence: a cloud of evaporating heptane-decane
# droplets (one parcel per cell centre) in hot gas with a Gaussian hot spot,
# run at several dt on a fixed grid (see test.py). With peleLM.spray_SDC = 1
# the extrema converge at second order in time; without it, at first order.
#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 1
geometry.coord_sys   = 0
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.0 1.0

#--------------------------BC FLAGS------------------------------
peleLM.lo_bc = Symmetry Interior
peleLM.hi_bc = Outflow Interior

#-------------------------AMR CONTROL----------------------------
amr.n_cell = 32 32
amr.v               = 1
amr.max_level       = 0
amr.blocking_factor = 16
amr.max_grid_size   = 64

#--------------------------Problem--------------------------------
prob.P_mean = 101325.0
prob.init_redist   = -1
prob.T0_gas = 1000.0
prob.vel_gas = 0.0
prob.blob_dT = 200.0
prob.blob_sigma = 0.1
prob.num_particles = (32, 32, 1)
prob.num_ppp = 0.2
prob.part_temp = 315.0
prob.part_dia = 0.001961
prob.part_vel = 0.0 0.0 0.0
prob.part_Re = -1.0

#------------------------PeleLM CONTROL-----------------------------
peleLM.v = 1
peleLM.num_init_iter = 0
peleLM.sdc_iterMax = 2
peleLM.spray_SDC = 1
peleLM.do_temporals = 1
peleLM.do_extremas = 1
peleLM.temporal_int = 1

#------------------------TIME STEPPING------------------------------
# The test runs to t = 0.2 with amr.fixed_dt = 0.2 / amr.max_step for
# several max_step (see add_test_dt in Tests/CMakeLists.txt)
amr.stop_time = 0.4
amr.max_step = 8
amr.fixed_dt = 0.025

#--------------------------IO CONTROL-------------------------------
amr.plot_file = "plt"
amr.plot_int = -1
amr.check_int = -1

# -----------------------LINEAR SOLVERS-----------------------------
mac_proj.verbose = 0
nodal_proj.verbose = 0
diffusion.verbose = 0
diffusion.rtol = 1.0e-12

# ------------------INPUTS TO CHEMISTRY REACTOR---------------------
peleLM.chem_integrator = "ReactorNull"

#--------------------SPRAY PARTICLE DATA-----------------------
peleLM.do_spray_particles = 1
particles.v             = 0
particles.cfl           = 1.
particles.fixed_parts = 1
particles.mom_transfer  = 1
particles.mass_transfer = 1
# spray_SDC needs the second-order particle integrator
particles.time_order = 2
particles.write_ascii_files = 0

# -----------------------------------------------------------------------------
# Liquid fuel properties for GCM in Pele
# Fuel: heptane-decane
# Number of compounds: 2
# Generated: 2025-09-01 17:19:14
# FuelLib remote URL: https://github.com/NatLabRockies/FuelLib.git
# Git commit: 2512fdf6ba66194a6b696c72ab370f5e8fb720d9
# Units: MKS
# -----------------------------------------------------------------------------

particles.fuel_species = NC7H16 NC10H22
particles.Y_0 = 0.7375 0.2625
particles.dep_fuel_species = NC7H16 NC10H22

# Properties for NC7H16 in MKS
particles.NC7H16_family = 0 # saturated hydrocarbons
particles.NC7H16_molar_weight = 0.100000 # kg/mol
particles.NC7H16_crit_temp = 549.855981 # K
particles.NC7H16_crit_press = 2821129.514417 # Pa
particles.NC7H16_crit_vol = 0.000425 # m^3/mol
particles.NC7H16_boil_temp = 379.073212 # K
particles.NC7H16_acentric_factor = 0.336945 # -
particles.NC7H16_molar_vol = 0.000146 # m^3/mol
particles.NC7H16_cp_a = 1636.255000 # J/kg/K
particles.NC7H16_cp_b = 3046.511000 # J/kg/K
particles.NC7H16_cp_c = -983.629000 # J/kg/K
particles.NC7H16_latent = 383110.000000 # J/kg

# Properties for NC10H22 in MKS
particles.NC10H22_family = 0 # saturated hydrocarbons
particles.NC10H22_molar_weight = 0.142000 # kg/mol
particles.NC10H22_crit_temp = 623.690516 # K
particles.NC10H22_crit_press = 2115522.932445 # Pa
particles.NC10H22_crit_vol = 0.000592 # m^3/mol
particles.NC10H22_boil_temp = 452.596977 # K
particles.NC10H22_acentric_factor = 0.468050 # -
particles.NC10H22_molar_vol = 0.000196 # m^3/mol
particles.NC10H22_cp_a = 1630.488028 # J/kg/K
particles.NC10H22_cp_b = 3098.105634 # J/kg/K
particles.NC10H22_cp_c = -1024.456338 # J/kg/K
particles.NC10H22_latent = 368035.211268 # J/kg