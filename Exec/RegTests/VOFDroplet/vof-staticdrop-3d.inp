# CI: static drop with surface tension in 3D, density ratio 1000, R / dx = 6.
# Velocity must stay small (spurious currents) and the pressure jump match
# the Laplace value 2 sigma / R = 8
#----------------------- Geometry ------------------------------
geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 1.0 1.0
peleLM.lo_bc = SlipWallAdiab SlipWallAdiab SlipWallAdiab
peleLM.hi_bc = SlipWallAdiab SlipWallAdiab SlipWallAdiab

#----------------------- AMR -----------------------------------
amr.n_cell          = 24 24 24
amr.v               = 1
amr.max_level       = 0
amr.n_error_buf     = 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 24

#----------------------- Problem -------------------------------
prob.type   = static
prob.center = 0.5 0.5 0.5
prob.radius = 0.25

#----------------------- PeleLMeX ------------------------------
peleLM.v              = 1
peleLM.incompressible = 1
peleLM.vof.rho_liquid = 1.0
peleLM.vof.rho_gas    = 1.0e-3
peleLM.vof.mu_liquid  = 1.0e-2
peleLM.vof.mu_gas     = 1.0e-4
peleLM.vof.sigma      = 1.0
peleLM.vof.v          = 1
nodal_proj.rtol = 1.0e-11
mac_proj.rtol   = 1.0e-11

#----------------------- Time stepping -------------------------
amr.cfl       = 0.45
amr.dt_shrink = 1.0
amr.init_dt   = 1.0e-4
amr.max_step  = 5
amr.stop_time = 1.0
amr.plot_file = plt
amr.check_int = -1

#----------------------- Temporals (read by Tests/test_vof.py) -
peleLM.do_temporals = 1
peleLM.temporal_int = 1
peleLM.do_extremas  = 1
