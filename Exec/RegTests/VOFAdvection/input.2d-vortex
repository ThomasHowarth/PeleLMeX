# Circle in the time-reversed single-vortex flow (Rider & Kothe), with AMR.
# Maximum stretching at t = period/2, back to a circle at t = period.

#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0

peleLM.lo_bc = Interior Interior
peleLM.hi_bc = Interior Interior

#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 64 64
amr.v               = 1
amr.max_level       = 2
amr.ref_ratio       = 2 2
amr.regrid_int      = 4
amr.n_error_buf     = 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 64

#--------------------------- Problem ----------------------------
prob.type        = vortex
prob.center      = 0.5 0.75
prob.radius      = 0.15
prob.period      = 4.0

#-------------------------PeleLM CONTROL-------------------------
peleLM.v              = 1
peleLM.incompressible = 1
peleLM.vof.rho_liquid = 1.0
peleLM.vof.rho_gas    = 1.0
peleLM.vof.mu_liquid  = 1.0e-3
peleLM.vof.mu_gas     = 1.0e-3
peleLM.do_init_proj   = 0
peleLM.num_init_iter  = 0

peleLM.vof.advect_only = 1
peleLM.vof.v           = 1

# The velocity passes through zero at t = period/2: use a fixed time step,
# Courant number 0.5 at the peak speed (1) on the finest level (dx = 1/256)
amr.fixed_dt  = 0.001953125
amr.stop_time = 4.0
amr.max_step  = 100000
amr.plot_per  = 1.0
amr.plot_file = plt_vortex_
amr.check_int = -1
