# CI: Zalesak disk, 2 levels; volume conserved, never clipped
#----------------------- Geometry ------------------------------
geometry.is_periodic = 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0
peleLM.lo_bc = Interior Interior
peleLM.hi_bc = Interior Interior

#----------------------- AMR -----------------------------------
amr.n_cell          = 64 64
amr.v               = 1
amr.max_level       = 1
amr.ref_ratio       = 2
amr.regrid_int      = 4
amr.n_error_buf     = 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 64

#----------------------- Problem -------------------------------
prob.type        = zalesak
prob.center      = 0.5 0.75
prob.radius      = 0.15
prob.slot_width  = 0.05
prob.slot_length = 0.25
prob.period      = 1.0

#----------------------- PeleLMeX ------------------------------
peleLM.v              = 1
peleLM.incompressible = 1
peleLM.rho            = 1.0
peleLM.mu             = 1.0e-3
peleLM.do_init_proj   = 0
peleLM.num_init_iter  = 0
peleLM.vof.advect_only = 1
peleLM.vof.v           = 1

#----------------------- Time stepping -------------------------
amr.cfl       = 0.45
amr.dt_shrink = 1.0
amr.max_step  = 20
amr.stop_time = 1.0
amr.plot_file = plt
amr.check_int = -1

#----------------------- Temporals (read by Tests/test_vof.py) -
peleLM.do_temporals = 1
peleLM.temporal_int = 1
peleLM.do_extremas  = 1
