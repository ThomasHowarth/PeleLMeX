## Volume of fluid: geometric PLIC interface capturing.
##
## Wired in through LMdirs in Exec/Make.PeleLMeX when USE_VOF = TRUE, which
## adds this directory to both INCLUDE_LOCATIONS and VPATH_LOCATIONS.

## Header
CEXE_headers += PeleLMeX_VOF_K.H
CEXE_headers += PeleLMeX_VOF_Unsplit_K.H

## Sources
CEXE_sources += PeleLMeX_VOF.cpp
